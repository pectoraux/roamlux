# RoamLink environment variables (example). Copy to .env and fill in.
# On Vercel, set these in Project Settings → Environment Variables.

# Neon PostgreSQL (pooled for app, direct for migrations)
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="https://your-domain.vercel.app"

# Bootstrap platform administrator (real, non-demo — set a strong value & rotate after first deploy)
PLATFORM_ADMIN_EMAIL="admin@example.com"
PLATFORM_ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_SECRET"

# Trusted demo toggle (marks seeded demo identities; does NOT bypass auth)
DEMO_MODE="true"
